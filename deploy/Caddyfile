# Bloco do Dominó para o FIM de ~/caddy/Caddyfile na VPS (cópia versionada em
# vps-infra/caddy/Caddyfile). Um destino só: o processo serve o cliente e a API,
# e o Caddy 2 repassa o Upgrade do WebSocket sozinho.
domino.imp-software.cloud {
	import seguranca
	encode gzip zstd

	reverse_proxy domino-api:3000

	log {
		output file /var/log/caddy/domino.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
